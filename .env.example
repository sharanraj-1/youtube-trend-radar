# ---------- Required ----------
# Neon Postgres connection string (auto-added when you install Neon from the Vercel Marketplace).
DATABASE_URL=
# YouTube Data API v3 key (Google Cloud console -> APIs & Services -> Credentials). Free: 10,000 units/day.
YOUTUBE_API_KEY=
# Gemini API key from https://aistudio.google.com/apikey (free tier).
GEMINI_API_KEY=
# Gemini model used for ALL AI tasks (enrichment + synthesis).
GEMINI_MODEL=gemini-3.8-flash
# (gemini-2.5-flash is no longer available to new API users; any Flash model works, e.g. gemini-flash-latest)
# Optional: Flash models to fall back to when the primary hits its free daily quota or is overloaded.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
# Random 32+ chars. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"; also guards /api/pipeline/step.
CRON_SECRET=
# Password for the /settings admin page (8+ chars).
ADMIN_PASSWORD=
# Random 32+ chars used to HMAC-sign feedback links in the brief.
FEEDBACK_SECRET=
# Public production URL, e.g. https://youtube-trend-radar.vercel.app (used for self-triggering + links).
APP_BASE_URL=

# ---------- Optional ----------
# Resend email delivery (web brief is the primary deliverable).
RESEND_API_KEY=
# Sender, e.g. onboarding@resend.dev for testing (can only send to your own Resend account email).
RESEND_FROM=
# Telegram failure/success alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
